# Upload Service Configuration
NODE_ENV=development
UPLOAD_SERVICE_PORT=5002
# Redis Configuration
REDIS_URL=redis://localhost:6379/2

# Upload Directory
# IMPORTANT: Must be an absolute path in production (e.g., /app/uploads)
# For Coolify: Set to /app/uploads and map persistent storage to this path
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
